{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "tayo. design system — tokens in W3C DTCG format (Light + Dark mode). Extracted from https://tayoszn.vercel.app. CSS mirror: tokens.css (prefix --t-).",
  "color": {
    "$type": "color",
    "ink": { "$value": "#151515", "$description": "Primary text, nav tab, active states. Called `base` on the source site." },
    "ink-warm": { "$value": "#302f2d", "$description": "Long-form article prose body color (.prose / .tayo-prose)." },
    "paper": { "$value": "#efefef", "$description": "Home & case study page background (`light`)." },
    "paper-reading": { "$value": "#fbfbfb", "$description": "Brighter reading surface used on /blog and /blog/[slug]." },
    "white": { "$value": "#ffffff", "$description": "Polaroid frames, sticker borders, inputs, modals." },
    "well": { "$value": "#f5f5f5", "$description": "Inset wells: project cards, segmented control track." },
    "bubble": { "$value": "#fafafa", "$description": "Comment speech bubbles and read-only boxes (neutral-50)." },
    "night": { "$value": "#0d0e0e", "$description": "Footer stage and dark mode primary canvas." },
    "cta-top": { "$value": "#2a2a2a" },
    "cta-bottom": { "$value": "#111111" },
    "lime": { "$value": "#bef264", "$description": "Signature footer wordmark hue at 30% opacity. Never use for UI controls." },
    "danger": { "$value": "#ef4444", "$description": "Active heart / like icon color (red-500)." },
    "ink-alpha": {
      "3": { "$value": "#15151508" },
      "5": { "$value": "#1515150d", "$description": "Chips, tags, year badges, feature cards" },
      "10": { "$value": "#1515151a", "$description": "Case study year pill, comment avatar" },
      "15": { "$value": "#15151526", "$description": "Hairline separators, input borders" },
      "20": { "$value": "#15151533", "$description": "Placeholder monograms, blockquote border" },
      "30": { "$value": "#1515154d", "$description": "Focused input border" },
      "35": { "$value": "#00000059", "$description": "Secondary display words" },
      "40": { "$value": "#00000066", "$description": "Hero paragraph, muted action icons" },
      "50": { "$value": "#15151580", "$description": "Inactive tabs, blog excerpts, script statement" },
      "60": { "$value": "#15151599", "$description": "Byline metadata, back link" },
      "65": { "$value": "#151515a6", "$description": "Card description copy" },
      "70": { "$value": "#151515b3", "$description": "Tag label, case study body copy, article deck" },
      "80": { "$value": "#151515cc", "$description": "Card subtitle, feature card text, comment body" }
    },
    "semantic": {
      "bg": { "$value": "{color.paper}" },
      "bg-reading": { "$value": "{color.paper-reading}" },
      "fg": { "$value": "{color.ink}" },
      "fg-prose": { "$value": "{color.ink-warm}" },
      "fg-muted": { "$value": "{color.ink-alpha.65}" },
      "fg-subtle": { "$value": "{color.ink-alpha.50}" },
      "fg-faint": { "$value": "{color.ink-alpha.35}" },
      "surface": { "$value": "{color.well}" },
      "surface-raised": { "$value": "{color.white}" },
      "surface-bubble": { "$value": "{color.bubble}" },
      "chip": { "$value": "{color.ink-alpha.5}" },
      "rule": { "$value": "#0000001a" },
      "hairline": { "$value": "{color.ink-alpha.15}" },
      "hatch": { "$value": "#0000000d" },
      "inverse-bg": { "$value": "{color.ink}" },
      "inverse-fg": { "$value": "{color.paper}" },
      "stage-bg": { "$value": "{color.night}" },
      "stage-fg": { "$value": "#ffffffe6" },
      "accent": { "$value": "#bef2644d" }
    },
    "dark": {
      "$description": "Dark mode semantic & primitive overrides (.dark / [data-theme='dark'])",
      "bg": { "$value": "#0d0e0e" },
      "bg-reading": { "$value": "#111212" },
      "fg": { "$value": "#efefef" },
      "fg-prose": { "$value": "#e4e2dd" },
      "surface": { "$value": "#151717" },
      "surface-raised": { "$value": "#1c1e1e" },
      "surface-bubble": { "$value": "#181a1a" },
      "frame": { "$value": "#222424" },
      "nav-bg": { "$value": "#171919" },
      "nav-border": { "$value": "#ffffff14" },
      "cta-top": { "$value": "#f5f5f5" },
      "cta-bottom": { "$value": "#d8d8d8" },
      "cta-fg": { "$value": "#151515" },
      "rule": { "$value": "#ffffff1a" },
      "hatch": { "$value": "#ffffff0d" },
      "ink-alpha": {
        "3": { "$value": "#efefef0a" },
        "5": { "$value": "#efefef12" },
        "10": { "$value": "#efefef1f" },
        "15": { "$value": "#efefef29" },
        "20": { "$value": "#efefef38" },
        "30": { "$value": "#efefef52" },
        "35": { "$value": "#efefef61" },
        "40": { "$value": "#efefef73" },
        "50": { "$value": "#efefef8c" },
        "60": { "$value": "#efefefa3" },
        "65": { "$value": "#efefefb3" },
        "70": { "$value": "#efefefc2" },
        "80": { "$value": "#efefefd9" }
      }
    }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "sans": { "$value": ["-apple-system", "BlinkMacSystemFont", "SF Pro Display", "Inter Variable", "Inter", "Segoe UI", "sans-serif"] },
      "hand": { "$value": ["Caveat", "Segoe Print", "cursive"], "$description": "Handwritten voice. Source class name is `.serif` (misnomer)." },
      "prose-display": { "$value": ["Piazzolla", "Georgia", "serif"], "$description": "Editorial serif used for h1/h2/h3 inside `.prose` blog articles." },
      "mono": { "$value": ["ui-monospace", "SFMono-Regular", "Menlo", "Monaco", "Consolas", "monospace"] }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": { "$value": 400 },
      "medium": { "$value": 500 },
      "semibold": { "$value": 600 },
      "bold": { "$value": 700 }
    },
    "size": {
      "$type": "dimension",
      "micro": { "$value": "11px" },
      "xs": { "$value": "0.75rem" },
      "btn": { "$value": "13px" },
      "sm": { "$value": "0.875rem" },
      "md": { "$value": "1rem" },
      "lg": { "$value": "1.125rem" },
      "xl": { "$value": "1.25rem" },
      "2xl": { "$value": "1.5rem" },
      "3xl": { "$value": "1.875rem" },
      "4xl": { "$value": "2.25rem" },
      "5xl": { "$value": "3rem" },
      "6xl": { "$value": "3.75rem" },
      "display": { "$value": "clamp(1.75rem, 4vw, 2.1rem)" },
      "closing": { "$value": "clamp(2.5rem, 4vw, 3rem)" },
      "wordmark": { "$value": "clamp(5rem, 44vw, 28rem)" }
    },
    "tracking": {
      "$type": "dimension",
      "body": { "$value": "-0.3px" },
      "copy": { "$value": "-0.035em" },
      "display": { "$value": "-0.06em" },
      "tighter": { "$value": "-0.065em" },
      "wordmark": { "$value": "-0.09em" },
      "eyebrow": { "$value": "0.08em" }
    },
    "leading": {
      "$type": "number",
      "display": { "$value": 0.8 },
      "tight": { "$value": 1.05 },
      "heading": { "$value": 1.2 },
      "copy": { "$value": 1.45 },
      "normal": { "$value": 1.5 },
      "relaxed": { "$value": 1.625 },
      "prose": { "$value": 1.8 }
    }
  },
  "typography": {
    "$type": "typography",
    "display": { "$value": { "fontFamily": "{font.family.sans}", "fontSize": "{font.size.display}", "fontWeight": 500, "lineHeight": 0.8, "letterSpacing": "-0.06em" } },
    "subline": { "$value": { "fontFamily": "{font.family.sans}", "fontSize": "{font.size.display}", "fontWeight": 500, "lineHeight": 1.05, "letterSpacing": "-0.065em" } },
    "statement": { "$value": { "fontFamily": "{font.family.sans}", "fontSize": "{font.size.3xl}", "fontWeight": 400, "lineHeight": 1.2, "letterSpacing": "-0.3px" } },
    "script-heading": { "$value": { "fontFamily": "{font.family.hand}", "fontSize": "{font.size.3xl}", "fontWeight": 700, "lineHeight": 1.2, "letterSpacing": "-0.3px" } },
    "blog-hero-script": { "$value": { "fontFamily": "{font.family.hand}", "fontSize": "{font.size.6xl}", "fontWeight": 700, "lineHeight": 1.05, "letterSpacing": "-0.3px" } },
    "article-title": { "$value": { "fontFamily": "{font.family.sans}", "fontSize": "{font.size.5xl}", "fontWeight": 700, "lineHeight": 1.2, "letterSpacing": "-0.3px" } },
    "case-section-heading": { "$value": { "fontFamily": "{font.family.sans}", "fontSize": "{font.size.3xl}", "fontWeight": 700, "lineHeight": 1.25, "letterSpacing": "-0.3px" } },
    "prose-body": { "$value": { "fontFamily": "{font.family.sans}", "fontSize": "{font.size.lg}", "fontWeight": 400, "lineHeight": 1.8, "letterSpacing": "-0.3px" } },
    "closing": { "$value": { "fontFamily": "{font.family.sans}", "fontSize": "{font.size.closing}", "fontWeight": 600, "lineHeight": 1.05, "letterSpacing": "-0.03em" } },
    "card-title": { "$value": { "fontFamily": "{font.family.sans}", "fontSize": "{font.size.lg}", "fontWeight": 600, "lineHeight": 1.55, "letterSpacing": "-0.3px" } },
    "body": { "$value": { "fontFamily": "{font.family.sans}", "fontSize": "{font.size.sm}", "fontWeight": 400, "lineHeight": 1.45, "letterSpacing": "-0.035em" } },
    "meta": { "$value": { "fontFamily": "{font.family.sans}", "fontSize": "{font.size.xs}", "fontWeight": 500, "lineHeight": 1.33, "letterSpacing": "-0.3px" } },
    "mono-meta": { "$value": { "fontFamily": "{font.family.mono}", "fontSize": "{font.size.micro}", "fontWeight": 400, "lineHeight": 1.5, "letterSpacing": "0" } }
  },
  "space": {
    "$type": "dimension",
    "1": { "$value": "0.25rem" }, "2": { "$value": "0.5rem" }, "3": { "$value": "0.75rem" },
    "4": { "$value": "1rem" }, "5": { "$value": "1.25rem" }, "6": { "$value": "1.5rem" },
    "7": { "$value": "1.75rem" }, "8": { "$value": "2rem" }, "10": { "$value": "2.5rem" },
    "12": { "$value": "3rem" }, "16": { "$value": "4rem" }, "24": { "$value": "6rem" },
    "32": { "$value": "8rem", "$description": "pt-32 top clearance under fixed dock-tab nav on subpages" }
  },
  "size": {
    "$type": "dimension",
    "column": { "$value": "55rem", "$description": "880px home & blog index column (max-w-220)" },
    "case-width": { "$value": "56rem", "$description": "896px project case study column (max-w-4xl)" },
    "nav-width": { "$value": "50rem" },
    "prose": { "$value": "42rem" },
    "list": { "$value": "48rem", "$description": "768px blog list & article column (max-w-3xl)" },
    "modal-width": { "$value": "24rem" },
    "rail-offset": { "$value": "25rem", "$description": "left-100 / right-100 on home & blog index" },
    "rail-offset-wide": { "$value": "10rem", "$description": "left-40 / right-40 on project case study page" },
    "divider-height": { "$value": "4rem" },
    "touch-min": { "$value": "2.75rem" }
  },
  "radius": {
    "$type": "dimension",
    "2xs": { "$value": "0.25rem" }, "xs": { "$value": "0.375rem" }, "sm": { "$value": "0.5rem" },
    "lg": { "$value": "0.75rem" }, "xl": { "$value": "1rem" }, "2xl": { "$value": "1.5rem" },
    "tab": { "$value": "26px" }, "pill": { "$value": "9999px" }
  },
  "shadow": {
    "$type": "shadow",
    "nav": { "$value": { "offsetX": "0", "offsetY": "8px", "blur": "30px", "spread": "0", "color": "#302f2d0d" } },
    "button": { "$value": { "offsetX": "0", "offsetY": "4px", "blur": "10px", "spread": "0", "color": "#0000000d" } },
    "polaroid": { "$value": { "offsetX": "0", "offsetY": "8px", "blur": "12px", "spread": "-4px", "color": "#2d190926" } },
    "panel": { "$value": { "offsetX": "0", "offsetY": "12px", "blur": "40px", "spread": "0", "color": "#1515150d" } },
    "modal": { "$value": { "offsetX": "0", "offsetY": "24px", "blur": "48px", "spread": "-12px", "color": "#0000002e" } },
    "inset": { "$value": { "offsetX": "0", "offsetY": "2px", "blur": "4px", "spread": "0", "color": "#0000000d", "inset": true } }
  },
  "motion": {
    "easing": {
      "$type": "cubicBezier",
      "out": { "$value": [0, 0, 0.2, 1] },
      "standard": { "$value": [0.4, 0, 0.2, 1] },
      "reveal": { "$value": [0.22, 1, 0.36, 1] }
    },
    "duration": {
      "$type": "duration",
      "fast": { "$value": "150ms" },
      "base": { "$value": "300ms" },
      "slow": { "$value": "500ms" },
      "reveal": { "$value": "700ms" },
      "stagger": { "$value": "80ms" },
      "carousel-loop": { "$value": "20s" }
    },
    "distance": {
      "$type": "dimension",
      "text": { "$value": "16px" },
      "section": { "$value": "24px" },
      "card": { "$value": "30px" },
      "nav-drop": { "$value": "-24px" }
    }
  }
}
